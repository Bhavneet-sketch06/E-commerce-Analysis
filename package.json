{
  "name": "offer-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Personalised offer engine: rules-bounded AI offers delivered over Telegram",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "realism": "node scripts/realism.js",
    "dryrun": "node scripts/dryrun.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard": "npm --prefix dashboard run dev",
    "build": "npm --prefix dashboard ci --include=dev && npm --prefix dashboard run build"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "grammy": "^1.46.0"
  }
}
